[Unit]
Description=MQTT Forward Device Agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/default/mqtt-forward

[Service]
Type=notify
ExecStart=/usr/bin/mqtt-forward device
EnvironmentFile=/etc/default/mqtt-forward
Environment=GOMEMLIMIT=32MiB
Restart=always
RestartSec=5
WatchdogSec=30
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
