[Unit]
Description=MQTT Forward Device Agent
Documentation=https://github.com/vitalvas/mqtt-forward
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/mqtt-forward device
EnvironmentFile=-/etc/mqtt-forward/mqtt-forward.env
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
