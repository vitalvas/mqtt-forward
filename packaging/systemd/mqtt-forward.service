[Unit]
Description=MQTT Forward Device Agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/mqtt-forward/mqtt-forward.env

[Service]
Type=simple
ExecStart=/usr/bin/mqtt-forward device
EnvironmentFile=/etc/mqtt-forward/mqtt-forward.env
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
